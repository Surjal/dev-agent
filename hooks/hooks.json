{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/project-boundary-guard.cjs\"",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\project-boundary-guard.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
